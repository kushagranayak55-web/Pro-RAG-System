# Copy this file to .env and fill in your own keys. Never commit .env.

MISTRAL_API_KEY=your_mistral_api_key
COHERE_API_KEY=your_cohere_api_key
GROQ_API_KEY=your_groq_api_key

# Frontend origin(s) allowed to call the API (comma-separated).
# Local default is http://localhost:5173. Set this to your deployed frontend URL in production.
ALLOWED_ORIGINS=http://localhost:5173

# Optional
MAX_UPLOAD_MB=20
SESSION_TTL_SECONDS=3600
MAX_QUESTION_CHARS=1000

# Optional tracing with LangSmith (off unless LANGSMITH_TRACING=true).
# Traces include the question and the document text.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_key
# LANGSMITH_PROJECT=prorag
